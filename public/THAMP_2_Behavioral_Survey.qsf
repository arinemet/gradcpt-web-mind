tomStart":true,"SliderStartPositions":{"1":0.5},"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please rate how much energy this song has on a scale from 1 to 100. (1 being very low energy\/calm...","Choices":{"1":{"Display":"Energy"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"QuestionID":"QID337"}},{"SurveyID":"SV_e8J0joaICCrJgdE","Element":"SQ","PrimaryAttribute":"QID338","SecondaryAttribute":"Please listen to at least one minute of the following mp3 file. ${lm:\/\/Field\/1}","TertiaryAttribute":null,"Payload":{"QuestionText":"Please listen to at least one minute of the following mp3 file.<br><br>${lm:\/\/Field\/1}<br><br>","DefaultChoices":false,"DataExportTag":"Song 22 Norm","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please listen to at least one minute of the following mp3 file. ${lm:\/\/Field\/1}","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID338"}},{"SurveyID":"SV_e8J0joaICCrJgdE","Element":"SQ","PrimaryAttribute":"QID339","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q339","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":60,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":268,"NextAnswerId":1,"QuestionID":"QID339"}},{"SurveyID":"SV_e8J0joaICCrJgdE","Element":"SQ","PrimaryAttribute":"QID34","SecondaryAttribute":"Welcome! We are inviting you to take part in a research study. This consent form will tell you ab...","TertiaryAttribute":null,"Payload":{"QuestionText":"Welcome!\nWe are inviting you to take part in a research study. This consent form will tell you about the study. If you want a copy of this consent form for your records, you can print it from the screen.\nPlease carefully read the following information.&nbsp;<div><br><\/div><div>Key information about this research study:\nThe following is a short summary of this study to help you decide whether to be a part of this study. This study is about how musical training affects the brain. You will be asked to complete surveys and to do computerized tasks. We expect that you the entire research study will take between 45 - 60 minutes. Your participation in this study does not involve any risk to you beyond that of everyday life. If you feel uncomfortable with any aspect of the study, you may discontinue at any time. All responses are completely anonymous. Your real-life face, body, and voice will NOT be recorded. Only aggregated results will be published. There will be no direct benefit to you other than contributing to scientific research and financial compensation for participating.&nbsp;<\/div><div><br><\/div><div>Why am I being asked to take part in this research study?\nWe are asking you to be in this study either because you are undergoing musical training, or because you have no formal musical training and are a control subject for our study. You should be between the ages of 18 and 65 years old and normal hearing.&nbsp;<\/div><div><br><\/div><div>Why is this research study being done?\nThis study is part of the research to better understand how musical training may influence the brain and cognition&nbsp;<\/div><div><br><\/div><div>What will I be asked to do?\nYou will be asked to complete several questionnaires that relate to your handedness, musical training and engagement, health history, demographics, and a questionnaire that determines your musical experience. Then, you will proceed with computerized listening and\/or cognitive tests. This study will take between 45-60 minutes.&nbsp;<\/div><div><br><\/div><div>Will I benefit by being in this research?\nThere will be no direct benefit to you for taking part in this study. However, information gained from this study may help scientists to better understand how the brain responds to music and music training. You will be compensated financially for your participation.&nbsp;<\/div><div><br><\/div><div>Who will see the information about me?\nYour participation in this study is confidential. No reports or publications will identify you in any way as being part of this project. All responses will be submitted using an anonymous identification number. The information you give us will be strictly confidential and will not be made available to anyone who is not directly involved in analyzing the data.&nbsp;<\/div><div><br><\/div><div>Can I stop my participation in this study?\nYour participation in this research is completely voluntary. You do not have to participate if you do not want to and you can refuse to answer any question. Even if you begin the study, you may quit at any time.&nbsp;<\/div><div><br><\/div><div>Who can I contact if I have questions or problems?\nIf you have any questions about this study, please feel free to contact Dr. Psyche Loui (mindlabwes@gmail.com), the Principal Investigator.&nbsp;<\/div><div><br><\/div><div>Who can I contact about my rights as a participant?\nIf you have any questions about your rights in this research, you may contact Nan C. Regina, Director, Human Subject Research Protection, Mail Stop: 560-177, 360 Huntington Avenue, Northeastern University, Boston, MA 02115. Tel: 617.373.4588, Email: n.regina@neu.edu. You may call anonymously if you wish.&nbsp;<\/div><div><br><\/div><div>Consent&nbsp;<\/div><div>If you want a copy of this consent for your records, you can print it from the screen.&nbsp;<\/div><div><br><\/div>","DefaultChoices":false,"DataExportTag":"Q001.text","QuestionID":"QID34","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome! We are inviting you to take part in a research study. This consent form will tell you ab...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_e8J0joaICCrJgdE","Element":"SQ","PrimaryAttribute":"QID340","SecondaryAttribute":"Please rate how happy or sad this song made you feel on a scale for 1 to 100. (1 being very sad\/n...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please rate how happy or sad this song made you feel on a scale for 1 to 100. (1 being very sad\/negative and 100 being very happy\/positive)","DefaultChoices":false,"DataExportTag":"Q340","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"SliderStartPositions":{"1":0.49534883720930233952373100692057050764560699462890625},"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please rate how happy or sad this song made you feel on a scale for 1 to 100. (1 being very sad\/n...","Choices":{"1":{"Display":"Happiness"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"QuestionID":"QID340"}},{"SurveyID":"SV_e8J0joaICCrJgdE","Element":"SQ","PrimaryAttribute":"QID341","SecondaryAttribute":"Please rate how much energy this song has on a scale from 1 to 100. (1 being very low energy\/calm...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please rate how much energy this song has on a scale from 1 to 100. (1 being very low ener